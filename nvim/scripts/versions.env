# Neovim 脚本使用的固定版本与校验和
# 用法：在脚本中 source 本文件；环境变量可以覆盖这些默认值。

TREE_SITTER_VERSION="${TREE_SITTER_VERSION:-0.27.1}"
TREE_SITTER_LATEX_VERSION="${TREE_SITTER_LATEX_VERSION:-0.6.0}"

TREE_SITTER_LATEX_URL="${TREE_SITTER_LATEX_URL:-https://codeload.github.com/latex-lsp/tree-sitter-latex/tar.gz/refs/tags/v${TREE_SITTER_LATEX_VERSION}}"
TREE_SITTER_LATEX_SHA256="${TREE_SITTER_LATEX_SHA256:-90d2085c9a46f5da0918ead2fa9b764defd57c34d493f06160f796014d2fd16a}"

TREE_SITTER_SOURCE_URL="${TREE_SITTER_SOURCE_URL:-https://codeload.github.com/tree-sitter/tree-sitter/tar.gz/refs/tags/v${TREE_SITTER_VERSION}}"
TREE_SITTER_SOURCE_SHA256="${TREE_SITTER_SOURCE_SHA256:-982cd3d4d9eb7be18c243240a622423fd2e4ecb4bec2cd98832c2f3fa1f0f333}"
