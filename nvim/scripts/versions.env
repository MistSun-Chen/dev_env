# Neovim 脚本使用的固定版本与校验和
# 用法：在脚本中 source 本文件；环境变量可以覆盖这些默认值。

TREE_SITTER_VERSION="${TREE_SITTER_VERSION:-0.27.1}"
TREE_SITTER_LATEX_VERSION="${TREE_SITTER_LATEX_VERSION:-0.6.0}"

# Mermaid ASCII 预览（nvim/lua/config/mermaid_ascii.lua）的运行时依赖。
MERMAID_ASCII_VERSION="${MERMAID_ASCII_VERSION:-1.6.2}"
MERMAID_ASCII_SHA256_DARWIN_ARM64="${MERMAID_ASCII_SHA256_DARWIN_ARM64:-ee46ce2f41f83ef59830c541c23b99a7937cea278b7502218d079b973fd2ac1b}"
MERMAID_ASCII_SHA256_DARWIN_X86_64="${MERMAID_ASCII_SHA256_DARWIN_X86_64:-947c7aae051819b499d20ac109473936cd96fccd51244f1d851bd6161e463f10}"
MERMAID_ASCII_SHA256_LINUX_ARM64="${MERMAID_ASCII_SHA256_LINUX_ARM64:-121bc3594f08cf41be2d0c9ec31b4103d81b21852290e2817b5c536f66a59446}"
MERMAID_ASCII_SHA256_LINUX_X86_64="${MERMAID_ASCII_SHA256_LINUX_X86_64:-e85222d5cedb39cfc346af02a0b68d2c90663e47d6512cc042fa7eb866bf2a30}"

# 在线安装的 language server 版本；离线包目前不包含它们。
PYRIGHT_VERSION="${PYRIGHT_VERSION:-1.1.414}"
# 5.8.1 要求 Node >=20；Ubuntu 24.04 apt 是 Node 18，固定到兼容 Node 18 的 5.6.0。
BASH_LANGUAGE_SERVER_VERSION="${BASH_LANGUAGE_SERVER_VERSION:-5.6.0}"

TREE_SITTER_LATEX_URL="${TREE_SITTER_LATEX_URL:-https://codeload.github.com/latex-lsp/tree-sitter-latex/tar.gz/refs/tags/v${TREE_SITTER_LATEX_VERSION}}"
TREE_SITTER_LATEX_SHA256="${TREE_SITTER_LATEX_SHA256:-90d2085c9a46f5da0918ead2fa9b764defd57c34d493f06160f796014d2fd16a}"

TREE_SITTER_SOURCE_URL="${TREE_SITTER_SOURCE_URL:-https://codeload.github.com/tree-sitter/tree-sitter/tar.gz/refs/tags/v${TREE_SITTER_VERSION}}"
TREE_SITTER_SOURCE_SHA256="${TREE_SITTER_SOURCE_SHA256:-982cd3d4d9eb7be18c243240a622423fd2e4ecb4bec2cd98832c2f3fa1f0f333}"
