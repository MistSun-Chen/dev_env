# 在线安装、离线下载、离线安装共用的版本与校验和
# 用法：在脚本中 source 本文件；环境变量可以覆盖这些默认值。

NVIM_VERSION="${NVIM_VERSION:-0.12.3}"
FZF_VERSION="${FZF_VERSION:-0.74.5}"
TREE_SITTER_VERSION="${TREE_SITTER_VERSION:-0.27.1}"

# Neovim 0.12.3 官方 Linux tarball 的 SHA256
NVIM_SHA256_X86_64="${NVIM_SHA256_X86_64:-c441b547142860bf01bcce39e36cbed185c41112813e15443b16e5237750724d}"
NVIM_SHA256_ARM64="${NVIM_SHA256_ARM64:-e055af73fa9c72b37456da8d204fa5c09850bc07e80e9176fe3b87d4afb7a3fc}"

# tree-sitter CLI 0.27.1 官方 zip 的 SHA256
TREE_SITTER_SHA256_X86_64="${TREE_SITTER_SHA256_X86_64:-c7e686aec16ba17053c2e6fd87600ccb10cf8ba3d055756b17e756d538e11114}"
TREE_SITTER_SHA256_ARM64="${TREE_SITTER_SHA256_ARM64:-3c0d0113cae3fea36f2336c271cbdacbcdb349edb006319155652b9386803c55}"

# tmux 自包含构建（在线/离线统一 3.8，不使用 Ubuntu 源里的 3.4）
TMUX_VERSION="${TMUX_VERSION:-3.8}"
TMUX_SHA256="${TMUX_SHA256:-e79c699c7e949dccd0a4a125e17b8d1261e311b16979dbc8eb34542f3966d82e}"
LIBEVENT_VERSION="${LIBEVENT_VERSION:-2.1.13}"
LIBEVENT_SHA256="${LIBEVENT_SHA256:-f7e9383b8c0baa81b687e5b5eecc01beefaf1b19b64151d95ed61647fe7a315c}"
UTF8PROC_VERSION="${UTF8PROC_VERSION:-2.12.0}"
UTF8PROC_SHA256="${UTF8PROC_SHA256:-a393fbef160835fb315bc3e91ba8d86f7a73a7cec9e6198b6c60b848b498bfeb}"

# Ubuntu 24.04 需要安装的系统包（apt 包名）
# gcc/libc6-dev 用于编译 latex Tree-sitter parser；make/bison/libncurses-dev
# 用于构建 tmux 3.8。这里不包含 clangd、g++、npm 和 language server。
APT_PACKAGES="${APT_PACKAGES:-ca-certificates curl git ripgrep fd-find gcc libc6-dev make bison libncurses-dev libncurses6 libncursesw6 libtinfo6 pkg-config file binutils unzip nodejs zsh ncurses-term xz-utils}"
# 离线目标端不需要编译器：latex parser 和 tmux 已在下载端构建。
# tmux 运行时依赖系统 ncurses；不安装 apt 的 tmux 3.4。
APT_PACKAGES_OFFLINE="${APT_PACKAGES_OFFLINE:-ca-certificates curl git ripgrep fd-find unzip libncurses6 libncursesw6 libtinfo6 zsh ncurses-term xz-utils}"

# Starship prompt
STARSHIP_VERSION="${STARSHIP_VERSION:-1.27.0}"
STARSHIP_SHA256_X86_64="${STARSHIP_SHA256_X86_64:-10c8eb4cb3b761d9bf59ea828444c2dab36c900b7d69a69e08814b286969df89}"
STARSHIP_SHA256_ARM64="${STARSHIP_SHA256_ARM64:-341f5cbf24699fa0b27ec88965ad25f862ea09e15d35a543fd6ffdff1d2aa00d}"

# Nerd Fonts Meslo
NERD_FONT_VERSION="${NERD_FONT_VERSION:-3.5.1}"
NERD_FONT_ASSET="${NERD_FONT_ASSET:-Meslo.tar.xz}"
NERD_FONT_SHA256="${NERD_FONT_SHA256:-6b6624632dc6873dfb7681c3f818e7c01ab601ab707690b6440933bbe57e2b11}"
